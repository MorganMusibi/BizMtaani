// Tracks which lazy chunks we've already started fetching this
// session, so hovering the same link twice doesn't re-trigger a
// network request.
const prefetched = new Set<string>();

export function prefetchRoute(key: string, importFn: () => Promise<unknown>) {
  if (prefetched.has(key)) return;
  prefetched.add(key);
  importFn().catch(() => {
    // A failed prefetch is harmless — the normal lazy import on
    // actual navigation will just try again.
    prefetched.delete(key);
  });
}
